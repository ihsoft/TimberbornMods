    <Style src="project://database/Assets/Mods/Automation/AssetBundles/Resources/UI/Views/IgorZ.Automation/SignalModuleOrderStyle.uss?fileID=7433441132597879392&amp;guid=4c90993be2cc4683bcc931642abae26d&amp;type=3#SignalModuleOrderStyle"/>
    <engine:VisualElement class="content-row-centered signal-module-order-dialog">
        <engine:Instance template="NamedBoxTemplate" style="width: 650px; height: 650px;">
            <AttributeOverrides element-name="Header" text-loc-key="IgorZ.Automation.SignalModuleOrder.DialogHeader"/>
            <Timberborn.CoreUI.LocalizableLabel text="Drag modules to reorder them, or use the arrow buttons." text-loc-key="IgorZ.Automation.SignalModuleOrder.Instructions" class="text--default" style="white-space: normal; margin-bottom: 10px;"/>
            <engine:VisualElement style="height: 440px; flex-shrink: 0;">
                <engine:ListView name="ModuleList" fixed-item-height="32" selection-type="None" reorderable="true" reorder-mode="Animated" class="panel-list-view text--default scroll--green-decorated signal-module-order-list" style="flex-grow: 1;"/>
                <engine:ScrollView name="ModuleListPreview" mode="Vertical" class="panel-list-view text--default scroll--green-decorated signal-module-order-list" style="position: absolute; top: 0; right: 0; bottom: 0; left: 0;">
                    <engine:VisualElement class="unity-list-view__reorderable-item signal-module-order-list__preview-item">
                        <engine:VisualElement class="unity-list-view__reorderable-handle"/>
                        <engine:VisualElement class="unity-list-view__reorderable-item__container">
                            <engine:Instance template="SignalModuleOrderRowTmpl" class="signal-module-order-list__preview-instance">
                                <AttributeOverrides element-name="ModuleName" text="StreamGauge"/>
                            </engine:Instance>
                        </engine:VisualElement>
                    </engine:VisualElement>
                    <engine:VisualElement class="unity-list-view__reorderable-item signal-module-order-list__preview-item">
                        <engine:VisualElement class="unity-list-view__reorderable-handle"/>
                        <engine:VisualElement class="unity-list-view__reorderable-item__container">
                            <engine:Instance template="SignalModuleOrderRowTmpl" class="signal-module-order-list__preview-instance">
                                <AttributeOverrides element-name="ModuleName" text="Time"/>
                            </engine:Instance>
                        </engine:VisualElement>
                    </engine:VisualElement>
                    <engine:VisualElement class="unity-list-view__reorderable-item signal-module-order-list__preview-item">
                        <engine:VisualElement class="unity-list-view__reorderable-handle"/>
