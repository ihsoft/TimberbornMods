<engine:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:engine="UnityEngine.UIElements" xmlns:editor="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../../../../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <engine:VisualElement name="ModuleRow" class="signal-module-order-row">
        <engine:VisualElement class="signal-module-order-row__content">
            <engine:Label text="Module" name="ModuleName" class="text--default signal-module-order-row__label"/>
            <engine:VisualElement class="signal-module-order-row__buttons">
                <Timberborn.CoreUI.NineSliceButton name="MoveUpButton" class="button-arrow-up button-square signal-module-order-row__button" style="margin-left: 4px;"/>
                <Timberborn.CoreUI.NineSliceButton name="MoveDownButton" class="button-arrow-down button-square signal-module-order-row__button" style="margin-left: 4px;"/>
            </engine:VisualElement>
        </engine:VisualElement>
    </engine:VisualElement>
</engine:UXML>
